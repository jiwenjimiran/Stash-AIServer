# Sample config for Docker running inside WSL2 with network_mode: host
#
# When using network_mode: host, the backend container shares WSL2's
# network stack directly.  localhost inside the container IS the WSL2
# host, which in mirrored networking mode also reaches the Windows host.
#
# Key differences from the standard Docker config:
#   - DOCKER=false  (no URL rewriting needed — localhost works natively)
#   - AI_SERVER_DB_HOST=localhost  (postgres exposes 5432 on the host)
#   - STASH_URL uses localhost  (reaches Stash on Windows via mirrored mode)
#
# See docker-compose.wsl2.yml for the matching compose configuration.

AI_SERVER_DATA_DIR=/app/data
AI_SERVER_DB_HOST=localhost
AI_SERVER_DB_PORT=5432
AI_SERVER_DB_NAME=stash_ai_server
AI_SERVER_DB_USER=stash_ai_server
AI_SERVER_DB_PASSWORD=stash_ai_server

AI_SERVER_HOST=0.0.0.0
AI_SERVER_PORT=4153
AI_SERVER_PLUGINS_DIR=/app/plugins

# Do NOT set DOCKER=true with network_mode: host.
# host.docker.internal does not route correctly in WSL2 mirrored mode.
DOCKER=false

STASH_URL=http://localhost:9999
